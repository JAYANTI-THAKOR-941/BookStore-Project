
    <%- include('navbar') %>

    <h1 class="title">Explore Our Books</h1>
    <div class="container">
        <% books.forEach((b)=>{ %>
            <div class="card">
                <img src="<%= b.image %>" alt="">
                <h3><%= b.title %></h3>
                <p><%= b.description %></p>
                <p>Price : ₹<%= b.price %></p>
                <p>Author:<%= b.author %></p>
                <p>Publish_date:<%= b.publish_date %></p>
                <button>Buy Now</button>
            </div>
        <% }); %>
    </div>
