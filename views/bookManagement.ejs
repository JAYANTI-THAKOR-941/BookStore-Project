    <%- include('header',{title:"Book Management"}) %>
    <h1 class="title">Book Management</h1>
    <a href="/add" class="add-btn">Add New Book</a>
    <table>
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Description</th>
            <th>Price</th>
            <th>Author</th>
            <th>Publish Date</th>
            <th>Action</th>
        </tr>
        <% books.forEach((b)=>{ %>
            <tr>
                <td><img src="<%= b.image %>" alt=""></td>
                <td><%= b.title %></td>
                <td><%= b.description %></td>
                <td><%= b.price %></td>
                <td><%= b.author %></td>
                <td><%= b.publish_date %></td>
                <td><a href="/edit/<%= b.id %>">Edit</a></td>
            </tr>
       <% }); %>
    </table>
