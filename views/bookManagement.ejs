<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Management</title>
    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        table{
            width: 90%;
            margin: 4% auto;
        }
        table,tr,td,th{
            border: 1px solid black;
            border-collapse: collapse;
            padding: 8px;
        }
        img{
            width: 80px;
        }
    </style>
</head>
<body>
    <h1>Book Management</h1>
    <a href="/add">Add New Book</a>
    <table>
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Description</th>
            <th>Price</th>
            <th>Author</th>
            <th>Publish Date</th>
            <th>Action</th>
        </tr>
        <% books.forEach((b)=>{ %>
            <tr>
                <td><img src="<%= b.image %>" alt=""></td>
                <td><%= b.title %></td>
                <td><%= b.description %></td>
                <td><%= b.price %></td>
                <td><%= b.author %></td>
                <td><%= b.publish_date %></td>
                <td><a href="/edit/<%= b.id %>">Edit</a></td>
            </tr>
       <% }); %>
    </table>
</body>
</html>